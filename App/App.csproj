<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FingerprintMacroPad</AssemblyName>
    <RootNamespace>FingerprintMacroPad</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.5</Version>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- also embed so WPF can load per-size frames at runtime for the window/title bar -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- We use WinForms/System.Drawing only via explicit usings/aliases (NotifyIcon,
       Keys, IconFactory); drop the implicit namespaces so WPF types win
       (Application, UserControl, KeyEventArgs, Brush, Color). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
