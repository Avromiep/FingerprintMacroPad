<Window x:Class="FingerprintMacroPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FingerprintMacroPad"
        Title="Fingerprint Macro Pad"
        Width="760" Height="880" MinWidth="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Border Margin="12" CornerRadius="16" Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="52" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image x:Name="AppIconImage" Width="22" Height="22"/>
                    <TextBlock Text="Fingerprint Macro Pad" Foreground="{DynamicResource Text}"
                               FontWeight="SemiBold" FontSize="13.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="BtnTheme" Style="{StaticResource IconButton}" Content="&#xE706;" Click="BtnTheme_Click" ToolTip="Toggle light / dark"/>
                    <Button x:Name="BtnMin" Style="{StaticResource IconButton}" Content="&#xE921;" Click="BtnMin_Click"/>
                    <Button x:Name="BtnClose" Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,4,20,20">
                <StackPanel>

                    <!-- Status -->
                    <Border Style="{StaticResource CardBox}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="72" Height="72" Margin="0,0,18,0">
                                <Ellipse Stroke="{DynamicResource Stroke}" StrokeThickness="2"/>
                                <Ellipse x:Name="IndicatorPulse" Fill="{DynamicResource Accent}" Opacity="0"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock x:Name="IndicatorNumber" Text="0" Foreground="{DynamicResource Text}"
                                           FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtStatus" Style="{StaticResource H1}" Text="Listening"/>
                                <TextBlock x:Name="TxtLastFired" Style="{StaticResource Dim}" Margin="0,4,0,0"
                                           Text="Tap your sensor with any finger to fire a macro."/>
                                <TextBlock x:Name="TxtAdminWarn" Foreground="{DynamicResource Danger}" FontSize="12.5"
                                           Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                           Text="Not running as administrator — the sensor can't be read. Restart the app elevated."/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Behaviour -->
                    <Border Style="{StaticResource CardBox}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Behaviour" Margin="0,0,0,4"/>

                            <DockPanel Margin="0,12,0,0">
                                <CheckBox x:Name="SwEnabled" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right"
                                          Checked="SwEnabled_Toggled" Unchecked="SwEnabled_Toggled"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Listening"/>
                                    <TextBlock Style="{StaticResource Dim}" Text="Watch the sensor and fire macros on taps."/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Margin="0,14,0,0">
                                <CheckBox x:Name="SwExclude" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right"
                                          Checked="SwExclude_Toggled" Unchecked="SwExclude_Toggled"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Ignore my unlock finger"/>
                                    <TextBlock Style="{StaticResource Dim}" Text="Only fingers that don't unlock the PC will trigger macros."/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Margin="0,14,0,0">
                                <CheckBox x:Name="SwWake" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right"
                                          Checked="SwWake_Toggled" Unchecked="SwWake_Toggled"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Wake screen on tap"/>
                                    <TextBlock Style="{StaticResource Dim}" Text="When the display is off, a tap wakes it instead of firing a macro."/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Margin="0,14,0,0">
                                <CheckBox x:Name="SwAutoStart" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right"
                                          Checked="SwAutoStart_Toggled" Unchecked="SwAutoStart_Toggled"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Start with Windows"/>
                                    <TextBlock Style="{StaticResource Dim}" Text="Launch automatically (elevated) at sign-in."/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="TAP WINDOW"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnTapMinus" Style="{StaticResource GhostButton}" Content="&#x2212;" Width="40" Padding="0,7" Click="TapMinus_Click"/>
                                        <TextBlock x:Name="TxtTapWindow" Width="86" TextAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text}" FontSize="13" Text="500 ms"/>
                                        <Button x:Name="BtnTapPlus" Style="{StaticResource GhostButton}" Content="+" Width="40" Padding="0,7" Click="TapPlus_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="DEBOUNCE"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnDebMinus" Style="{StaticResource GhostButton}" Content="&#x2212;" Width="40" Padding="0,7" Click="DebMinus_Click"/>
                                        <TextBlock x:Name="TxtDebounce" Width="86" TextAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text}" FontSize="13" Text="120 ms"/>
                                        <Button x:Name="BtnDebPlus" Style="{StaticResource GhostButton}" Content="+" Width="40" Padding="0,7" Click="DebPlus_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Macros -->
                    <TextBlock Style="{StaticResource CardTitle}" Text="Macros" Margin="2,2,0,10"/>
                    <local:PatternCard x:Name="Pc1"/>
                    <local:PatternCard x:Name="Pc2"/>
                    <local:PatternCard x:Name="Pc3"/>
                    <local:PatternCard x:Name="Pc4"/>

                    <!-- Import / Export -->
                    <Border Style="{StaticResource CardBox}" Margin="0,2,0,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnImport" Style="{StaticResource GhostButton}" Content="Import" Margin="0,0,8,0" Click="BtnImport_Click"/>
                                <Button x:Name="BtnExport" Style="{StaticResource AccentButton}" Content="Export" Click="BtnExport_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardTitle}" Text="Backup &amp; transfer"/>
                                <TextBlock Style="{StaticResource Dim}" Text="Export your macros to a file, or import them on another PC."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Updates -->
                    <Border Style="{StaticResource CardBox}" Margin="0,2,0,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnCheckUpdate" Style="{StaticResource GhostButton}" Content="Check for updates" Click="BtnCheckUpdate_Click"/>
                                <Button x:Name="BtnRelaunch" Style="{StaticResource AccentButton}" Content="Relaunch to update" Margin="8,0,0,0" Visibility="Collapsed" Click="BtnRelaunch_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardTitle}" x:Name="TxtVersion" Text="Version"/>
                                <TextBlock Style="{StaticResource Dim}" x:Name="TxtUpdateStatus" Text="Pull the latest release from GitHub."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Dim}" TextAlignment="Center" Margin="0,2,0,0"
                               Text="Read-only sensor use — never enrolls, reads, or deletes fingerprints."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
