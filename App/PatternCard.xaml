<UserControl x:Class="FingerprintMacroPad.PatternCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Badge -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <StackPanel x:Name="DotsPanel" Orientation="Horizontal" Height="16" Margin="0,2,0,10"/>
                <TextBlock x:Name="LblPattern" Style="{StaticResource CardTitle}" Text="Single tap"/>
                <TextBlock x:Name="TxtSummary" Style="{StaticResource Dim}" Margin="0,6,12,0" Text="Not set"/>
            </StackPanel>

            <!-- Editor -->
            <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource FieldLabel}" Text="ACTION"/>
                <ComboBox x:Name="CmbAction" Style="{StaticResource ThemedComboBox}" SelectedIndex="0">
                    <ComboBoxItem>Do nothing</ComboBoxItem>
                    <ComboBoxItem>Launch app</ComboBoxItem>
                    <ComboBoxItem>Open file / URL</ComboBoxItem>
                    <ComboBoxItem>Send hotkey</ComboBoxItem>
                    <ComboBoxItem>Media key</ComboBoxItem>
                    <ComboBoxItem>Run a saved file (.exe / .ps1 / .bat)</ComboBoxItem>
                    <ComboBoxItem>Run PowerShell / Batch (paste or drop a script)</ComboBoxItem>
                </ComboBox>

                <!-- Target + browse -->
                <StackPanel x:Name="PanTarget" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="LblTargetHint" Style="{StaticResource FieldLabel}" Text="TARGET"/>
                    <DockPanel>
                        <Button x:Name="BtnBrowse" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                Content="Browse" Margin="8,0,0,0" Padding="12,8" Click="BtnBrowse_Click"/>
                        <TextBox x:Name="TxtTarget" Style="{StaticResource ThemedTextBox}"
                                 TextChanged="Field_Changed"/>
                    </DockPanel>
                </StackPanel>

                <!-- Arguments -->
                <StackPanel x:Name="PanArgs" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="ARGUMENTS (OPTIONAL)"/>
                    <TextBox x:Name="TxtArgs" Style="{StaticResource ThemedTextBox}" TextChanged="Field_Changed"/>
                </StackPanel>

                <!-- Hotkey -->
                <StackPanel x:Name="PanHotkey" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="HOTKEY  (CLICK, THEN PRESS THE COMBO)"/>
                    <DockPanel>
                        <Button x:Name="BtnClearHotkey" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                Content="Clear" Margin="8,0,0,0" Padding="12,8" Click="BtnClearHotkey_Click"/>
                        <TextBox x:Name="TxtHotkey" Style="{StaticResource ThemedTextBox}" IsReadOnly="True"
                                 Text="Click and press keys…" PreviewKeyDown="TxtHotkey_PreviewKeyDown"/>
                    </DockPanel>
                </StackPanel>

                <!-- Inline script (paste or drag & drop) -->
                <StackPanel x:Name="PanScript" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                   Text="SCRIPT — PASTE, OR DROP A .PS1 / .BAT / .CMD FILE"/>
                        <ComboBox x:Name="CmbLang" Style="{StaticResource ThemedComboBox}" Width="140" Height="32"
                                  HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="Field_Changed">
                            <ComboBoxItem>PowerShell</ComboBoxItem>
                            <ComboBoxItem>Batch</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <Border CornerRadius="8" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                            Background="{DynamicResource Input}">
                        <TextBox x:Name="TxtScript" Style="{StaticResource ThemedTextBox}" Height="150"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" FontFamily="Consolas, Cascadia Mono, monospace"
                                 FontSize="12.5" BorderThickness="0" Background="Transparent"
                                 AllowDrop="True" PreviewDragOver="TxtScript_PreviewDragOver"
                                 Drop="TxtScript_Drop" TextChanged="Field_Changed"/>
                    </Border>
                </StackPanel>

                <!-- Media -->
                <StackPanel x:Name="PanMedia" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="MEDIA KEY"/>
                    <ComboBox x:Name="CmbMedia" Style="{StaticResource ThemedComboBox}" SelectedIndex="0"
                              SelectionChanged="Field_Changed">
                        <ComboBoxItem>Play / Pause</ComboBoxItem>
                        <ComboBoxItem>Next track</ComboBoxItem>
                        <ComboBoxItem>Previous track</ComboBoxItem>
                        <ComboBoxItem>Stop</ComboBoxItem>
                        <ComboBoxItem>Volume up</ComboBoxItem>
                        <ComboBoxItem>Volume down</ComboBoxItem>
                        <ComboBoxItem>Mute</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
